# URL API Gateway cho Vite proxy. Mặc định http://localhost:8080 (api-gateway).
# Đổi nếu Gateway chạy ở cổng khác. Không chứa mật khẩu database.
BACKEND_URL=http://localhost:8080

# Google OAuth2 Client ID cho tính năng Đăng nhập bằng Google
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

